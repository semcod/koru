#!/usr/bin/env bash
# c2004 sumr-refresh post-commit hook (lightweight alternative)
#
# Fires after every `git commit`. Does NOT run `sumr` — only prints a
# one-line hint if SUMR.md is stale. Zero overhead for fresh state.
#
# Prefer post-merge unless you specifically want per-commit visibility.
#
# Install:   bash scripts/git-hooks/install.sh post-commit
# Uninstall: rm .git/hooks/post-commit

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

if [ ! -x scripts/sumr-refresh.sh ]; then
  exit 0
fi

# Silent when fresh; one-line hint when stale. Never blocks.
if ! scripts/sumr-refresh.sh --status >/dev/null 2>&1; then
  echo "[sumr] hint: SUMR.md is stale — run 'task quality:sumr:auto' when convenient"
fi

exit 0
