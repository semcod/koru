#!/usr/bin/env bash
# c2004 sumr-refresh post-merge hook
#
# Fires after `git merge` / `git pull` (with merge). Triggers the debounced
# SUMR.md refresh — fast-path exit when SUMR.md is fresh, async background
# run when stale. Always non-blocking: git operations return immediately.
#
# Branch-aware: only fires on protected branches (main/master). Feature
# branches must refresh manually via `task quality:sumr:refresh`.
#
# Install:   bash scripts/git-hooks/install.sh post-merge
# Uninstall: rm .git/hooks/post-merge

set -e

# $1 = squash-merge flag (1 = squash, 0 = normal). Unused, but documented.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
case "${branch}" in
  main|master) ;;
  *) exit 0 ;;
esac

if [ ! -x scripts/sumr-refresh.sh ]; then
  exit 0
fi

# Fast path: status check is pure bash + git, ~5ms. No venv, no subprocess.
if scripts/sumr-refresh.sh --status >/dev/null 2>&1; then
  exit 0
fi

# Stale → async refresh under flock so concurrent pulls queue rather than
# race each other. Detached with setsid so it survives terminal close.
mkdir -p .sumr
LOG=".sumr/post-merge.log"
LOCK=".sumr/post-merge.lock"

run_detached() {
  setsid nohup scripts/sumr-refresh.sh > "${LOG}" 2>&1 < /dev/null &
  disown 2>/dev/null || true
}

if command -v flock >/dev/null 2>&1; then
  (
    flock -n 9 || exit 0
    run_detached
  ) 9>"${LOCK}"
else
  run_detached
fi

echo "[sumr] SUMR.md stale — refreshing in background (tail ${LOG})"
exit 0
