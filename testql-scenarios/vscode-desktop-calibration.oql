# SCENARIO: VS Code desktop preflight for coru calibration
# TYPE: desktop
# WUP: manual-only (DESKTOP_* needs live wmctrl; advisory on Wayland)

SET window_title "Visual Studio Code"
SET capture_path ".planfile/.koru/calibration-vscode-desktop.png"

DESKTOP_LIST
DESKTOP_FOCUS "${window_title}"
DESKTOP_ASSERT_WINDOW "${window_title}"
