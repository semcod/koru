FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-yaml \
    ncurses-term \
    locales \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml /app/
RUN python3 -m pip install --no-cache-dir --break-system-packages rich
COPY src/ /app/src/
COPY .planfile/ /app/.planfile/

ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "koru.cli_summary", "--no-github", "--root", "/app"]
