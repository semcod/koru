FROM alpine:3.20

RUN apk add --no-cache \
    python3 \
    py3-pip \
    py3-yaml \
    ncurses \
    bash

WORKDIR /app
COPY pyproject.toml /app/
RUN python3 -m pip install --no-cache-dir --break-system-packages rich
COPY src/ /app/src/
COPY .planfile/ /app/.planfile/

ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "koru.cli_summary", "--no-github", "--root", "/app"]
