FROM fedora:40

RUN dnf install -y --setopt=install_weak_deps=False \
    python3 \
    python3-pip \
    python3-pyyaml \
    ncurses \
    && dnf clean all

WORKDIR /app
COPY pyproject.toml /app/
RUN python3 -m pip install --no-cache-dir rich
COPY src/ /app/src/
COPY .planfile/ /app/.planfile/

ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "koru.cli_summary", "--no-github", "--root", "/app"]
