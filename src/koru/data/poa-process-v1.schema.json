{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/poa/poa-process.schema.v1.json",
  "title": "POA process, request, binding, observation, plan, execution and receipt contracts v1",
  "description": "Closed document family for Process-Oriented Architecture. A valid document describes data; it never grants execution authority.",
  "oneOf": [
    {"$ref": "#/$defs/process"},
    {"$ref": "#/$defs/requestInspect"},
    {"$ref": "#/$defs/requestPlan"},
    {"$ref": "#/$defs/binding"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/executionEnvelope"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "processRef": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^poa://[a-z0-9.-]+/process/[a-z][a-z0-9._:-]*/v[1-9][0-9]*$"
    },
    "capabilityRef": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^capability://[a-z0-9.-]+/[a-z][a-z0-9._:/-]*/v[1-9][0-9]*$"
    },
    "policyRef": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^policy://[a-z0-9.-]+/[a-z][a-z0-9._:/-]*/v[1-9][0-9]*$"
    },
    "artifactRef": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^artifact://[a-z0-9.-]+/[A-Za-z0-9._:/-]+/r[1-9][0-9]*$"
    },
    "schemaRef": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^schema://[a-z0-9.-]+/[A-Za-z0-9._:/-]+/v[1-9][0-9]*$"
    },
    "grammarRef": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^grammar://[a-z0-9.-]+/[A-Za-z0-9._:/-]+/v[1-9][0-9]*$"
    },
    "adapterRef": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^adapter://[a-z0-9.-]+/[A-Za-z0-9._:/-]+/v[1-9][0-9]*$"
    },
    "targetRef": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^target://[a-z0-9.-]+/[A-Za-z0-9._:/-]+$"
    },
    "processUri": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^[a-z][a-z0-9+.-]*://[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)*/(?:query|command)/[A-Za-z0-9._:-]+$"
    },
    "effect": {
      "enum": [
        "read_data",
        "local_write",
        "external_write",
        "credential_use",
        "quota_consumption",
        "remote_session",
        "destructive"
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/effect"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ref", "expectation_schema_ref"],
      "properties": {
        "capability_ref": {"$ref": "#/$defs/capabilityRef"},
        "expectation_schema_ref": {"$ref": "#/$defs/schemaRef"}
      }
    },
    "processStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_ref",
        "kind",
        "effects",
        "depends_on",
        "requires_approval",
        "timeout_seconds",
        "max_attempts",
        "idempotency",
        "verification"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "capability_ref": {"$ref": "#/$defs/capabilityRef"},
        "kind": {"enum": ["query", "command"]},
        "effects": {"$ref": "#/$defs/effects"},
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "requires_approval": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "idempotency": {"enum": ["required", "read_only", "unsupported"]},
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/verification"}
        },
        "compensation_capability_ref": {"$ref": "#/$defs/capabilityRef"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "query"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "effects": {
                "not": {
                  "contains": {
                    "enum": ["local_write", "external_write", "destructive"]
                  }
                }
              },
              "idempotency": {"const": "read_only"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "enum": ["external_write", "credential_use", "quota_consumption", "remote_session", "destructive"]
                }
              }
            },
            "required": ["effects"]
          },
          "then": {"properties": {"requires_approval": {"const": true}}}
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "process_ref",
        "title",
        "owner",
        "input_schema_ref",
        "output_schema_ref",
        "policy_refs",
        "steps"
      ],
      "properties": {
        "schema": {"const": "poa.process/v1"},
        "process_ref": {"$ref": "#/$defs/processRef"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "owner": {"type": "string", "maxLength": 160, "pattern": "^(?:human|agent|service):[a-zA-Z0-9._:-]+$"},
        "input_schema_ref": {"$ref": "#/$defs/schemaRef"},
        "output_schema_ref": {"$ref": "#/$defs/schemaRef"},
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/policyRef"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/processStep"}
        }
      }
    },
    "requestInspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "process_ref"],
      "properties": {
        "schema": {"const": "poa.request/v1"},
        "operation": {"const": "inspect"},
        "process_ref": {"$ref": "#/$defs/processRef"}
      }
    },
    "requestPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "process_ref", "input_ref", "input_sha256"],
      "properties": {
        "schema": {"const": "poa.request/v1"},
        "operation": {"const": "plan"},
        "process_ref": {"$ref": "#/$defs/processRef"},
        "input_ref": {"$ref": "#/$defs/artifactRef"},
        "input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding_id",
        "capability_ref",
        "process_uri",
        "target_ref",
        "adapter_ref",
        "observation_ref",
        "observation_sha256",
        "priority"
      ],
      "properties": {
        "schema": {"const": "poa.binding/v1"},
        "binding_id": {"$ref": "#/$defs/identifier"},
        "capability_ref": {"$ref": "#/$defs/capabilityRef"},
        "process_uri": {"$ref": "#/$defs/processUri"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "adapter_ref": {"$ref": "#/$defs/adapterRef"},
        "observation_ref": {"$ref": "#/$defs/artifactRef"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "priority": {"type": "integer", "minimum": -1000, "maximum": 1000}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "observation_id",
        "target_ref",
        "observed_at",
        "valid_until",
        "fact_schema_ref",
        "facts_ref",
        "facts_sha256",
        "read_only"
      ],
      "properties": {
        "schema": {"const": "poa.observation/v1"},
        "observation_id": {"$ref": "#/$defs/identifier"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "observed_at": {"type": "string", "maxLength": 40, "format": "date-time"},
        "valid_until": {"type": "string", "maxLength": 40, "format": "date-time"},
        "fact_schema_ref": {"$ref": "#/$defs/schemaRef"},
        "facts_ref": {"$ref": "#/$defs/artifactRef"},
        "facts_sha256": {"$ref": "#/$defs/sha256"},
        "read_only": {"const": true}
      }
    },
    "dslContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "grammar_ref",
        "schema_sha256",
        "grammar_sha256",
        "canonical_sha256",
        "canonicalization",
        "hash_algorithm",
        "validated",
        "additional_properties"
      ],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/schemaRef"},
        "grammar_ref": {"$ref": "#/$defs/grammarRef"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "grammar_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "canonicalization": {"const": "RFC8785"},
        "hash_algorithm": {"const": "SHA-256"},
        "validated": {"const": true},
        "additional_properties": {"const": false}
      }
    },
    "plannedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_ref",
        "process_uri",
        "target_ref",
        "kind",
        "effects",
        "depends_on",
        "input_ref",
        "input_sha256",
        "timeout_seconds",
        "max_attempts",
        "idempotency_key",
        "verification"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "capability_ref": {"$ref": "#/$defs/capabilityRef"},
        "process_uri": {"$ref": "#/$defs/processUri"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "kind": {"enum": ["query", "command"]},
        "effects": {"$ref": "#/$defs/effects"},
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "input_ref": {"$ref": "#/$defs/artifactRef"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/verification"}
        },
        "compensation_process_uri": {"$ref": "#/$defs/processUri"}
      }
    },
    "authorityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "scopes", "grant_ttl_seconds", "intent_required", "plan_hash_binding"],
      "properties": {
        "subject": {"type": "string", "maxLength": 160, "pattern": "^(?:human|agent|service|mcp):[a-zA-Z0-9._:-]+$"},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 96, "pattern": "^[a-z][a-z0-9._:-]+$"}
        },
        "grant_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "intent_required": {"const": true},
        "plan_hash_binding": {"const": true}
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_ref", "host_shell", "arbitrary_executable", "transport_from_registry"],
      "properties": {
        "boundary_ref": {"$ref": "#/$defs/targetRef"},
        "host_shell": {"const": false},
        "arbitrary_executable": {"const": false},
        "transport_from_registry": {"const": true}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "process_ref",
        "request_sha256",
        "valid_until",
        "steps",
        "dsl_contract",
        "authority_requirements",
        "execution_boundary",
        "hash_profile",
        "plan_hash"
      ],
      "properties": {
        "schema": {"const": "poa.plan/v1"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "process_ref": {"$ref": "#/$defs/processRef"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "valid_until": {"type": "string", "maxLength": 40, "format": "date-time"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/plannedStep"}
        },
        "dsl_contract": {"$ref": "#/$defs/dslContract"},
        "authority_requirements": {"$ref": "#/$defs/authorityRequirements"},
        "execution_boundary": {"$ref": "#/$defs/executionBoundary"},
        "hash_profile": {"const": "RFC8785+SHA-256"},
        "plan_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "execution_id",
        "request_ref",
        "plan_ref",
        "grant_ref",
        "intent_ref",
        "subject",
        "lease_expires_at",
        "lease_revision",
        "idempotency_key"
      ],
      "properties": {
        "schema": {"const": "poa.execution-envelope/v1"},
        "execution_id": {"$ref": "#/$defs/identifier"},
        "request_ref": {"$ref": "#/$defs/sha256Ref"},
        "plan_ref": {"$ref": "#/$defs/sha256Ref"},
        "grant_ref": {"type": "string", "maxLength": 160, "pattern": "^grant:[a-zA-Z0-9._:-]+$"},
        "intent_ref": {"type": "string", "maxLength": 160, "pattern": "^intent:[a-zA-Z0-9._:-]+$"},
        "subject": {"type": "string", "maxLength": 160, "pattern": "^(?:human|agent|service|mcp):[a-zA-Z0-9._:-]+$"},
        "lease_expires_at": {"type": "string", "maxLength": 40, "format": "date-time"},
        "lease_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event_id",
        "run_id",
        "sequence",
        "process_ref",
        "plan_ref",
        "event_type",
        "occurred_at",
        "artifact_refs",
        "raw_output_included",
        "secret_material_included"
      ],
      "properties": {
        "schema": {"const": "poa.event/v1"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "process_ref": {"$ref": "#/$defs/processRef"},
        "plan_ref": {"$ref": "#/$defs/sha256Ref"},
        "event_type": {
          "enum": [
            "requested",
            "planned",
            "authorized",
            "started",
            "lease_renewed",
            "completed",
            "verified",
            "failed",
            "compensated",
            "cancelled",
            "timed_out",
            "denied",
            "expired"
          ]
        },
        "occurred_at": {"type": "string", "maxLength": 40, "format": "date-time"},
        "step_id": {"$ref": "#/$defs/identifier"},
        "artifact_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "raw_output_included": {"const": false},
        "secret_material_included": {"const": false}
      }
    },
    "stepReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "process_uri",
        "state",
        "attempts",
        "output_sha256",
        "output_bytes",
        "effect_verified",
        "verification_refs"
      ],
      "properties": {
        "step_id": {"$ref": "#/$defs/identifier"},
        "process_uri": {"$ref": "#/$defs/processUri"},
        "state": {"enum": ["succeeded", "failed", "compensated", "skipped", "cancelled", "timed_out", "denied", "expired"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 5},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "effect_verified": {"type": "boolean"},
        "verification_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "process_ref",
        "plan_ref",
        "grant_ref",
        "intent_ref",
        "state",
        "started_at",
        "completed_at",
        "steps",
        "raw_output_included",
        "secret_material_included",
        "hash_profile",
        "receipt_hash"
      ],
      "properties": {
        "schema": {"const": "poa.receipt/v1"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "process_ref": {"$ref": "#/$defs/processRef"},
        "plan_ref": {"$ref": "#/$defs/sha256Ref"},
        "grant_ref": {"type": "string", "maxLength": 160, "pattern": "^grant:[a-zA-Z0-9._:-]+$"},
        "intent_ref": {"type": "string", "maxLength": 160, "pattern": "^intent:[a-zA-Z0-9._:-]+$"},
        "state": {"enum": ["succeeded", "failed", "compensated", "cancelled", "timed_out", "denied", "expired"]},
        "started_at": {"type": "string", "maxLength": 40, "format": "date-time"},
        "completed_at": {"type": "string", "maxLength": 40, "format": "date-time"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/stepReceipt"}
        },
        "raw_output_included": {"const": false},
        "secret_material_included": {"const": false},
        "hash_profile": {"const": "RFC8785+SHA-256"},
        "receipt_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
