{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcod.github.io/koru/schemas/proposal-envelope-v1.schema.json",
  "title": "Koru ProposalEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_pack",
    "slots",
    "artifact",
    "bindings",
    "provenance",
    "hashes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "intent_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "slots": {
      "type": "object"
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content"],
          "properties": {
            "kind": {"const": "unified_diff"},
            "content": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content"],
          "properties": {
            "kind": {"enum": ["control_command", "semantic_patch"]},
            "content": {"type": "object"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content"],
          "properties": {
            "kind": {"const": "none"},
            "content": {"type": "null"}
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hash", "prompt_schema_hash"],
      "properties": {
        "input_hash": {"$ref": "#/$defs/sha256"},
        "prompt_schema_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "proposal_sha256"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
