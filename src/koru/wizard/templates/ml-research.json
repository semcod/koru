    "tpl_docs": {"title": "ML: dokumentacja", "labels": ["ml", "docs"], "priority": "normal", "body": "README z krokami repro + diagram pipeline {{project}}."},
    "tpl_tests": {"title": "ML: testy pipeline", "labels": ["ml", "tests"], "priority": "normal", "body": "pytest na transformacjach danych w {{project}}."},
    "tpl_typing": {"title": "ML: typowanie", "labels": ["ml", "typing"], "priority": "low", "body": "mypy na publicznym API datasetów {{project}}."}
