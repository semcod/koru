    },
    "quality": {
      "prompt": {"pl": "Jakość biblioteki?", "en": "Library quality?"},
      "options": [
        {"id": "tests", "label": {"pl": "Pokrycie testami", "en": "Test coverage"}, "ticket": "tpl_tests",
