    "tpl_examples": {"title": "Lib: przykłady", "labels": ["library", "docs"], "priority": "normal", "body": "examples/ + doctest dla głównych use-case {{project}}."},
    "tpl_modules": {"title": "Lib: modularyzacja", "labels": ["library", "architecture"], "priority": "normal", "body": "Import-linter contracts + jasne public API per moduł {{project}}."},
    "tpl_tests": {"title": "Lib: testy", "labels": ["library", "tests"], "priority": "high", "body": "90% coverage na public API {{project}}."},
    "tpl_ci_gates": {"title": "Lib: CI gates", "labels": ["library", "ci"], "priority": "normal", "body": "mypy + ruff + regix w CI {{project}}."}
