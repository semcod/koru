{
  "name": "koru-autopilot-vscode",
  "displayName": "koru autopilot",
  "description": "Bridge between VS Code / Windsurf / Cursor and the koru autopilot daemon.",
  "version": "0.1.7",
  "publisher": "semcod",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/semcod/koru.git",
    "directory": "plugins/koru-autopilot-vscode"
  },
  "bugs": {
    "url": "https://github.com/semcod/koru/issues"
  },
  "homepage": "https://github.com/semcod/koru/tree/main/plugins/koru-autopilot-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "koru",
    "autopilot",
    "cascade",
    "windsurf",
    "cursor",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "koruAutopilot.connect",
        "title": "koru: Connect autopilot daemon"
      },
      {
        "command": "koruAutopilot.sendChat",
        "title": "koru: Send text to active chat"
      }
    ],
    "configuration": {
      "title": "koru autopilot",
      "properties": {
        "koruAutopilot.socketPath": {
          "type": "string",
          "default": "",
          "description": "Unix socket override. Empty = KORU_AUTOPILOT_SOCKET, else KORU_AUTOPILOT_INSTANCE / XDG_RUNTIME_DIR (matches koru Python)."
        },
        "koruAutopilot.chatOpenCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Commands to open AI chat, tried in order (Cursor Composer, Copilot Chat, …). Empty = extension defaults."
        },
        "koruAutopilot.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Connect to the daemon automatically when the editor starts."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node out/dispatch-plan.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --out koru-autopilot-${npm_package_version}.vsix",
    "publish": "vsce publish --no-dependencies",
    "clean": "rm -rf out node_modules *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
