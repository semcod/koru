{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcod.github.io/koru/schemas/autonomy-mutation-inventory.schema.json",
  "title": "Koru autonomy namespace and mutation inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespaces",
    "capabilities",
    "mutation_entrypoints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namespace"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "mutation_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entrypoint"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "boundary", "roots", "owns", "must_not_own"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "boundary": {
          "enum": ["coru", "koru", "koruide", "koruvision"]
        },
        "roots": {"$ref": "#/$defs/nonEmptyStringArray"},
        "owns": {"$ref": "#/$defs/nonEmptyString"},
        "must_not_own": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "effect",
        "risk",
        "executor",
        "evidence",
        "enforcement"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner": {"$ref": "#/$defs/identifier"},
        "effect": {
          "enum": ["propose", "mutate", "control", "manage"]
        },
        "risk": {
          "enum": ["R0", "R1", "R2", "R3"]
        },
        "executor": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "enforcement": {
          "enum": ["contracted", "observed"]
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "intent",
        "capability",
        "modules",
        "current_executor",
        "target_executor",
        "evidence",
        "enforcement"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
        },
        "intent": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/identifier"},
        "modules": {"$ref": "#/$defs/nonEmptyStringArray"},
        "current_executor": {"$ref": "#/$defs/nonEmptyString"},
        "target_executor": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "enforcement": {
          "enum": ["contracted", "observed"]
        }
      }
    }
  }
}
