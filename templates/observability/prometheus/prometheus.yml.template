# Prometheus scrape config — generated by koru template:install:observability.
#
# Substitute placeholders before first run:
#   <APP_NAME>     — your app (e.g. myapp)
#   <APP_PORT>     — your app's HTTP port (e.g. 8000)
#   <APP_HOST>     — host:port of your main app (default: host.docker.internal)
#
# Targets assume your main app stack is already running on the host;
# Prometheus reaches it via host.docker.internal:host-gateway.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s
  external_labels:
    project: <APP_NAME>
    env: dev

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: [alertmanager:9093]

scrape_configs:
  # ── Prometheus self-scrape ─────────────────────────────────────────────
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # ── Application backend ────────────────────────────────────────────────
  - job_name: <APP_NAME>-backend
    metrics_path: /metrics
    static_configs:
      - targets: ['host.docker.internal:<APP_PORT>']
        labels:
          component: backend
          service: <APP_NAME>

  # ── Container metrics (cAdvisor) ───────────────────────────────────────
  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  # ── Host metrics (node-exporter) ───────────────────────────────────────
  - job_name: node-exporter
    static_configs:
      - targets: ['node-exporter:9100']

  # ── Synthetic HTTP probes (Blackbox Exporter) ──────────────────────────
  - job_name: blackbox-http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          # Substitute with your real endpoints.
          - http://host.docker.internal:<APP_PORT>/health
          # - http://host.docker.internal:<APP_PORT>/api/v1/status
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # ── Healing webhook self-scrape ───────────────────────────────────────
  - job_name: healing-webhook
    metrics_path: /metrics
    static_configs:
      - targets: ['healing-webhook:8810']
